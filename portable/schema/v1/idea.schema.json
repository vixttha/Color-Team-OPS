{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Idea v1 (project neutral)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "origin",
    "lifecycle_status",
    "implementation_status",
    "testing"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^IDEA-[0-9]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\r\\n<>]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "origin": {
      "type": "object",
      "required": [
        "source_note"
      ],
      "properties": {
        "source_note": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "enum": [
            "human",
            "assistant",
            "joint",
            "imported"
          ]
        },
        "source_catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle_status": {
      "enum": [
        "captured",
        "triaged",
        "exploring",
        "decision_ready",
        "adopted",
        "parked",
        "rejected",
        "superseded",
        "duplicate",
        "retired"
      ]
    },
    "implementation_status": {
      "enum": [
        "not_planned",
        "planned",
        "in_progress",
        "implemented",
        "removed",
        "not_applicable"
      ]
    },
    "testing": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "untested",
            "planned",
            "in_progress",
            "tested"
          ]
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "mixed",
            "inconclusive"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drawbacks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_ideas": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^IDEA-[0-9]{6}$"
      }
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "importance": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "complexity": {
      "enum": [
        "trivial",
        "low",
        "medium",
        "high",
        "very_high",
        "unknown"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source_ref"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "observed_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "decided_by",
        "reason",
        "source_ref"
      ],
      "properties": {
        "decided_by": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "adopted"
          }
        },
        "required": [
          "lifecycle_status"
        ]
      },
      "then": {
        "required": [
          "decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "testing": {
            "properties": {
              "status": {
                "const": "tested"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "testing"
        ]
      },
      "then": {
        "properties": {
          "testing": {
            "required": [
              "status",
              "outcome",
              "refs"
            ],
            "properties": {
              "refs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
