{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Feature v1 (project neutral)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "lifecycle_status",
    "implementation_status",
    "idea_ids",
    "acceptance_criteria",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\r\\n<>]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "lifecycle_status": {
      "enum": [
        "proposed",
        "planned",
        "in_progress",
        "implemented",
        "verified",
        "deprecated",
        "retired"
      ]
    },
    "implementation_status": {
      "enum": [
        "not_planned",
        "planned",
        "in_progress",
        "implemented",
        "removed"
      ]
    },
    "idea_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^IDEA-[0-9]{6}$"
      }
    },
    "project_milestone": {
      "type": "string",
      "maxLength": 80
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source_ref",
          "source_sha"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "observed_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "release_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "verified"
          }
        },
        "required": [
          "lifecycle_status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
