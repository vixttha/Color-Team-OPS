{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color-Team-OPS Feature Candidate v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "lifecycle_status",
    "implementation_status",
    "idea_ids",
    "planned_milestone",
    "source_refs",
    "verified_evidence",
    "release_membership",
    "acceptance_criteria",
    "authority_note"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_status": {
      "enum": [
        "proposed",
        "planned",
        "in_progress",
        "implemented",
        "verified",
        "deprecated",
        "retired"
      ]
    },
    "implementation_status": {
      "enum": [
        "not_planned",
        "planned",
        "in_progress",
        "implemented",
        "removed"
      ]
    },
    "idea_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^IDEA-[0-9]{6}$"
      }
    },
    "planned_milestone": {
      "enum": [
        "M1",
        "M2",
        "M3",
        "M4",
        "M5"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repository",
          "commit",
          "path"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "verified_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source_sha",
          "receipt"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "receipt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "release_membership": {
      "const": "NOT_ASSERTED"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "authority_note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "verified"
          }
        },
        "required": [
          "lifecycle_status"
        ]
      },
      "then": {
        "properties": {
          "verified_evidence": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
