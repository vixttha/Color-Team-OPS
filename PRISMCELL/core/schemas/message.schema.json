{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrismCell universal message v0.0.1 — team identities supplied by project config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "from_team",
    "from_branch",
    "to_team",
    "type",
    "priority",
    "summary",
    "source_ref",
    "source_sha",
    "evidence_links",
    "requested_action",
    "authority_scope",
    "status"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "pattern": "^IN-[A-Z]+-[0-9]{8}-[0-9]{3,6}$",
      "maxLength": 64
    },
    "from_team": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,39}$"
    },
    "from_branch": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "to_team": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,39}$"
    },
    "type": {
      "enum": [
        "REQUEST",
        "FINDING",
        "REVIEW",
        "CHALLENGE",
        "RESPONSE",
        "BLOCKER",
        "FYI"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "source_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|unknown)$"
    },
    "evidence_links": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 2048,
        "pattern": "^https://"
      }
    },
    "requested_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "authority_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "status": {
      "const": "POSTED"
    },
    "issue_url": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https://[^/]+/[^/]+/[^/]+/issues/[0-9]+$"
    },
    "posted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
