{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future v0.0.2 trusted-source gate record (still only a shape)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "mission_id",
    "phase",
    "verdict",
    "source_sha",
    "criterion_ids",
    "evidence_refs",
    "verifier_ref",
    "verified_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.0.2-prototype"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "VALIDATE",
        "INTERNAL_AUDIT"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED",
        "REPAIR",
        "BLOCKED"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "criterion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "verifier_ref": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "VALIDATE"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "UNVERIFIED"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "verdict": {
            "enum": [
              "PASS",
              "REPAIR",
              "BLOCKED",
              "UNVERIFIED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        },
        "required": [
          "verifier_ref",
          "verified_at"
        ]
      }
    }
  ]
}
