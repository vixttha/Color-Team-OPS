{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:color-team-ops:development:cli-test:1",
  "title": "Development CLI_TEST observation; never ChatGPT staging evidence",
  "type": "object",
  "required": ["host", "case_id", "arm", "attempt", "source_sha", "functional_source_sha", "environment_digest", "freeze_sha256", "input_sha256", "arm_sha256", "raw_sha256", "stderr_sha256", "started_at", "ended_at", "exit_code", "cli_version", "model_requested", "effort_requested", "model_observed", "status", "metrics"],
  "properties": {
    "host": {"const": "CLI_TEST"},
    "case_id": {"type": "string", "pattern": "^(yellow-team|orange-team|green-team|red-team|blue-team|purple-team|white-team|black-team|gray-cell):(normal|edge|adversarial):(0[1-9]|10)$"},
    "arm": {"enum": ["generic", "full", "no_directory", "no_handoff"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "source_sha": {"$ref": "#/$defs/gitsha"},
    "functional_source_sha": {"const": "0e9561fd06034674eca4fcf07ceef9381f8249a2"},
    "environment_digest": {"$ref": "#/$defs/digest"},
    "freeze_sha256": {"$ref": "#/$defs/digest"},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "arm_sha256": {"$ref": "#/$defs/digest"},
    "raw_sha256": {"$ref": "#/$defs/digest"},
    "stderr_sha256": {"$ref": "#/$defs/digest"},
    "session_sha256": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "latency_seconds": {"type": "number", "minimum": 0},
    "exit_code": {"type": ["integer", "null"]},
    "cli_version": {"type": "string", "minLength": 1},
    "model_requested": {"const": "gpt-6.1-sol"},
    "effort_requested": {"const": "medium"},
    "model_observed": {"const": "NOT_EXPOSED_BY_JSONL"},
    "model_identity_provenance": {"const": "CLI_REQUEST_NOT_PROVIDER_ATTESTED"},
    "status": {"enum": ["COMPLETED", "QUOTA_BLOCKED", "RATE_LIMIT_BLOCKED", "TIMEOUT", "EXECUTION_BLOCKED", "INVALID_TRACE"]},
    "metrics": {"type": "object", "required": ["holdout", "task_correctness", "independent_grade"], "properties": {"independent_grade": {"const": false}}},
    "usage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "tool_events": {"type": "array", "maxItems": 0},
    "grading": {"const": "EXPLORATORY_CLI_TEST_UNVERIFIED_INDEPENDENCE"},
    "reason": {"type": "string"}
  },
  "additionalProperties": false,
  "allOf": [{"if": {"properties": {"status": {"const": "COMPLETED"}}}, "then": {"required": ["session_sha256", "usage", "tool_events", "grading"], "properties": {"exit_code": {"const": 0}}}}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  }
}
