{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "reason",
    "mission_id"
  ],
  "properties": {
    "action": {
      "enum": [
        "DISPATCH",
        "COMPLETE",
        "IDLE",
        "BLOCK",
        "ESCALATE",
        "CAPABILITY_BLOCKED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "next_team": {
      "enum": [
        "orange-team",
        "yellow-team",
        "green-team",
        "blue-team",
        "red-team",
        "purple-team",
        "white-team",
        "black-team",
        "gray-cell"
      ]
    },
    "verification": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verifier_identity": {
      "type": "string",
      "minLength": 1
    },
    "verification_time": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "DISPATCH"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "next_team"
        ]
      },
      "else": {
        "not": {
          "required": [
            "next_team"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "const": "PASS"
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "required": [
          "source_sha",
          "evidence_refs",
          "verifier_identity",
          "verification_time"
        ]
      }
    }
  ]
}
