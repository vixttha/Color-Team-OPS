{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "mission_id",
    "team",
    "status",
    "evidence_state",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "team": {
      "enum": [
        "orange-team",
        "yellow-team",
        "green-team",
        "blue-team",
        "red-team",
        "purple-team",
        "white-team",
        "black-team",
        "gray-cell"
      ]
    },
    "status": {
      "enum": [
        "DONE",
        "FAILED",
        "BLOCKED"
      ]
    },
    "evidence_state": {
      "enum": [
        "OBSERVED",
        "UNVERIFIED",
        "MISSING"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "summary": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "authority",
              "security",
              "functional",
              "deployment",
              "defense",
              "adversary",
              "detection_gap",
              "threat_intel",
              "usability"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "observed_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_state": {
            "const": "OBSERVED"
          }
        },
        "required": [
          "evidence_state"
        ]
      },
      "then": {
        "required": [
          "source_sha",
          "evidence_refs",
          "observed_by"
        ]
      }
    }
  ]
}
